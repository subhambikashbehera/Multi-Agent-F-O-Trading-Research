# Market data: nse (free: nseindia.com + Yahoo Finance), kite, or sample (synthetic).
FNO_DATA_SOURCE=nse

# Zerodha Kite Connect, for later (https://developers.kite.trade)
KITE_API_KEY=
KITE_API_SECRET=
# Generated daily with `fno-research kite-login`; expires every morning.
KITE_ACCESS_TOKEN=

# Claude, used by the news agent. Without it the news agent is skipped.
ANTHROPIC_API_KEY=

# Risk engine
FNO_CAPITAL=500000
FNO_MAX_RISK_PCT=1.0
FNO_DAILY_LOSS_PCT=2.0
FNO_MAX_LOTS=1

# Lot sizes change with NSE circulars; override here when they do.
# FNO_LOT_NIFTY=65
# FNO_LOT_BANKNIFTY=30
